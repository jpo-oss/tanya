# Fieldy Public API key for the assistant's wearable transcript pipeline.
# Live copy lives at ~/.config/fieldy/fieldy.env (chmod 600), never in git.
# Get the key in the Fieldy mobile app: Settings (gear) > Developer Settings > API key.
FIELDY_API_KEY=sk-fieldy-REPLACE_ME
# Timezone used for the date and time in file names. Change while travelling
# (for example America/Los_Angeles) so a conversation files under the local day.
FIELDY_LOCAL_TZ=UTC
