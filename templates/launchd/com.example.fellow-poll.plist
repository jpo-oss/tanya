<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.<name>.fellow-poll</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>/Users/<you>/<Name>/bin/fellow-poll.py</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ASSISTANT_HOME</key><string>/Users/<you>/<Name></string>
    <key>VAULTS</key><string>/Users/<you>/<path-to-vaults-parent></string>
    <key>FELLOW_LOCAL_TZ</key><string><your IANA zone, for example Europe/London></string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/Users/<you>/<Name>/state/fellow/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/<you>/<Name>/state/fellow/launchd.err</string>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
