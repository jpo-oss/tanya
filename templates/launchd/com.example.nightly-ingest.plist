<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.<name>.<job></string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/<you>/<Name>/bin/<job>.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/<you>/<Name>/state/<job>/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/<you>/<Name>/state/<job>/launchd.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
