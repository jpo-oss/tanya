<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.<name>.telegram-watchdog</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>/Users/<you>/<Name>/bin/tg-watchdog</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>ASSISTANT_NAME</key><string><Name></string>
    <key>TG_TIMEZONE</key><string><your IANA zone, for example Europe/London></string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/<you>/<Name>/state/telegram/watchdog.out</string>
  <key>StandardErrorPath</key><string>/Users/<you>/<Name>/state/telegram/watchdog.err</string>
</dict>
</plist>
